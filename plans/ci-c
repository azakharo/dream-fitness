## GitHub Actions Workflow

### File Structure

```
.github/
└── workflows/
    └── ci-cd.yml
```

### Workflow Definition

```yaml
name: CI/CD Pipeline

on:
  push:
    branches:
      - master
      - main
  workflow_dispatch: # Manual trigger option

jobs:
  # Stage 1: Linting
  backend-lint:
    runs-on: self-hosted
    defaults:
      run:
        working-directory: backend
    steps:
      - uses: actions/checkout@v4

      - name: Setup Node.js
        uses: actions/setup-node@v4
        with:
          node-version: "24"
          cache: "npm"
          cache-dependency-path: backend/package-lock.json

      - name: Install dependencies
        run: npm ci

      - name: Run ESLint
        run: npm run lint

  frontend-check:
    runs-on: self-hosted
    defaults:
      run:
        working-directory: frontend
    steps:
      - uses: actions/checkout@v4

      - name: Setup Node.js
        uses: actions/setup-node@v4
        with:
          node-version: "24"
          cache: "npm"
          cache-dependency-path: frontend/package-lock.json

      - name: Install dependencies
        run: npm ci

      - name: Run ESLint
        run: npm run lint

      - name: TypeScript check
        run: npm run ts

  # Stage 2: Unit/E2E Tests
  unit-e2e-tests:
    runs-on: self-hosted
    needs: [backend-lint, frontend-check]
    defaults:
      run:
        working-directory: backend
    steps:
      - uses: actions/checkout@v4

      - name: Setup Node.js
        uses: actions/setup-node@v4
        with:
          node-version: "24"
          cache: "npm"
          cache-dependency-path: backend/package-lock.json

      - name: Install dependencies
        run: npm ci

      - name: Start test infrastructure
        run: npm run start:test:infra

      - name: Wait for PostgreSQL
        run: npx wait-on -t 60000 tcp:5432

      - name: Setup test database
        run: npm run test:setup

      - name: Run Unit tests
        run: npm run test:unit

      - name: Run E2E tests
        run: npm run test:e2e

      - name: Stop test infrastructure
        if: always()
        run: npm run stop:test:infra

  # Stage 3: Integration Tests
  integration-tests:
    runs-on: self-hosted
    needs: unit-e2e-tests
    defaults:
      run:
        working-directory: backend
    steps:
      - uses: actions/checkout@v4

      - name: Setup Node.js
        uses: actions/setup-node@v4
        with:
          node-version: "24"
          cache: "npm"
          cache-dependency-path: backend/package-lock.json

      - name: Install dependencies
        run: npm ci

      - name: Install Playwright browsers
        run: npx playwright install --with-deps chromium

      - name: Run migrations for integration tests
        run: npm run docker:test:migrate:auto

      - name: Start services for integration tests
        run: npm run docker:test

      - name: Wait for API Gateway
        run: npx wait-on -t 120000 http://localhost:3000/health

      - name: Run integration tests
        run: npm run test:api-gateway

      - name: Stop services
        if: always()
        run: npm run docker:test:down

  # Stage 4: Deploy
  deploy:
    runs-on: self-hosted
    needs: integration-tests
    if: github.ref == 'refs/heads/master' || github.ref == 'refs/heads/main'
    steps:
      - uses: actions/checkout@v4

      - name: Pull latest changes
        run: git pull origin master

      - name: Run database migrations
        run: |
          docker compose -f docker-compose.migrations.yml run --rm \
            -e RUN_MIGRATIONS=true \
            migration-runner

      - name: Deploy application
        run: docker compose -f docker-compose.prod.yml up -d --build

      - name: Wait for services
        run: npx wait-on -t 120000 https://fitness.ddns.net/health

      - name: Health check
        run: |
          response=$(curl -s -o /dev/null -w "%{http_code}" https://fitness.ddns.net/health)
          if [ "$response" != "200" ]; then
            echo "Health check failed with status $response"
            exit 1
          fi
          echo "Deployment successful!"
```

