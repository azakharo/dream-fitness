{
  "version": "0.2.0",
  "inputs": [
    {
      "id": "serviceName",
      "type": "pickString",
      "description": "Select service to test",
      "options": [
        "auth-service",
        "training-service"
      ],
      "default": "training-service"
    },
    {
      "id": "testName",
      "type": "promptString",
      "description": "Test name pattern (regex, leave empty to run all tests in file)",
      "default": ""
    }
  ],
  "configurations": [
    {
      "name": "Debug E2E Test",
      "type": "node",
      "request": "launch",
      "cwd": "${workspaceFolder}/backend",
      "program": "${workspaceFolder}/backend/node_modules/jest/bin/jest.js",
      "args": [
        "--config",
        "apps/${input:serviceName}/test/jest-e2e.json",
        "--runInBand",
        "--testNamePattern",
        "${input:testName}",
        "${relativeFile}"
      ],
      "env": { "NODE_ENV": "test" },
      "envFile": "${workspaceFolder}/backend/.env.test",
      "console": "integratedTerminal",
      "internalConsoleOptions": "openOnSessionStart"
    }
  ]
}
