{
  "name": "dreamfitness-backend",
  "version": "0.1.0",
  "description": "DreamFitness Backend - NestJS Monorepo",
  "author": "",
  "private": true,
  "license": "UNLICENSED",
  "scripts": {
    "build:auth-service": "nest build auth-service",
    "build:training-service": "nest build training-service",
    "build:booking-service": "nest build booking-service",
    "build:notification-service": "nest build notification-service",
    "build:api-gateway": "nest build api-gateway",
    "build": "nest build api-gateway && nest build auth-service && nest build training-service && nest build booking-service && nest build notification-service",
    "format": "prettier --write \"apps/**/*.ts\" \"libs/**/*.ts\" \"test/**/*.ts\"",
    "start:dev:infra": "docker-compose --env-file .env --env-file .env.development -f docker-compose.base.yml up -d --build",
    "stop:dev:infra": "docker-compose --env-file .env --env-file .env.development -f docker-compose.base.yml down",
    "dev": "npm run start:dev:infra && wait-on -t 120000 tcp:5432 tcp:5672 && concurrently --names api-gateway,auth-service,training-service,booking-service,notification-service --prefix-colors blue,green,yellow,magenta,cyan \"npm run start:dev:api-gateway\" \"npm run start:dev:auth-service\" \"npm run start:dev:training-service\" \"npm run start:dev:booking-service\" \"npm run start:dev:notification-service\"",
    "dev:stop": "npm run stop:dev:infra",
    "start:debug": "nest start --debug --watch",
    "start:prod": "node dist/apps/api-gateway/main",
    "start:dev:api-gateway": "nest start api-gateway --watch",
    "start:dev:auth-service": "nest start auth-service --watch",
    "start:dev:training-service": "nest start training-service --watch",
    "start:dev:booking-service": "nest start booking-service --watch",
    "start:dev:notification-service": "nest start notification-service --watch",
    "start:debug:api-gateway": "nest start api-gateway --debug --watch",
    "start:debug:auth-service": "nest start auth-service --debug --watch",
    "start:debug:training-service": "nest start training-service --debug --watch",
    "start:debug:booking-service": "nest start booking-service --debug --watch",
    "start:debug:notification-service": "nest start notification-service --debug --watch",
    "start:prod:api-gateway": "node dist/apps/api-gateway/main",
    "start:prod:auth-service": "node dist/apps/auth-service/main",
    "start:prod:training-service": "node dist/apps/training-service/main",
    "start:prod:booking-service": "node dist/apps/booking-service/main",
    "start:prod:notification-service": "node dist/apps/notification-service/main",
    "ts": "tsc --noEmit",
    "lint": "eslint \"{src,apps,libs,test,scripts}/**/*.ts\" --fix",
    "start:test:infra": "docker-compose --env-file .env --env-file .env.test -f docker-compose.base.yml up -d --build",
    "stop:test:infra": "docker-compose --env-file .env --env-file .env.test -f docker-compose.base.yml down",
    "test": "jest && npm run test:e2e",
    "test:unit": "jest",
    "test:watch": "jest --watch",
    "test:cov": "jest --coverage",
    "test:debug": "node --inspect-brk -r tsconfig-paths/register -r ts-node/register node_modules/.bin/jest --runInBand",
    "test:e2e": "cross-env NODE_ENV=test jest --config ./test/jest-e2e.json --runInBand",
    "test:db:create": "dotenv -e .env.test -- ts-node -r tsconfig-paths/register scripts/create-test-db.ts",
    "test:db:migrate": "dotenv -e .env.test -- ts-node -r tsconfig-paths/register ./node_modules/typeorm/cli.js migration:run -d src/data-source.ts",
    "test:setup": "npm run test:db:create && npm run test:db:migrate",
    "test:db:seed": "dotenv -e .env.test -- ts-node -r tsconfig-paths/register scripts/seed-test-db.ts",
    "test:e2e:auth": "cross-env NODE_ENV=test jest --config apps/auth-service/test/jest-e2e.json --runInBand",
    "test:e2e:auth:watch": "cross-env NODE_ENV=test jest --config apps/auth-service/test/jest-e2e.json --watch --runInBand",
    "test:e2e:training": "cross-env NODE_ENV=test jest --config apps/training-service/test/jest-e2e.json --runInBand",
    "test:e2e:booking": "cross-env NODE_ENV=test jest --config apps/booking-service/test/jest-e2e.json --runInBand",
    "test:e2e:booking:watch": "cross-env NODE_ENV=test jest --config apps/booking-service/test/jest-e2e.json --watch --runInBand",
    "migration:create": "ts-node -r tsconfig-paths/register ./node_modules/typeorm/cli.js migration:create -d src/data-source.ts",
    "migration:generate": "ts-node -r tsconfig-paths/register ./node_modules/typeorm/cli.js migration:generate -d src/data-source.ts",
    "migration:run": "ts-node -r tsconfig-paths/register ./node_modules/typeorm/cli.js migration:run -d src/data-source.ts",
    "migration:revert": "ts-node -r tsconfig-paths/register ./node_modules/typeorm/cli.js migration:revert -d src/data-source.ts",
    "migration:show": "ts-node -r tsconfig-paths/register ./node_modules/typeorm/cli.js migration:show -d src/data-source.ts",
    "db:migrate": "ts-node -r tsconfig-paths/register ./node_modules/typeorm/cli.js migration:run -d src/data-source.ts",
    "db:migrate:revert": "ts-node -r tsconfig-paths/register ./node_modules/typeorm/cli.js migration:revert -d src/data-source.ts",
    "db:drop": "ts-node -r tsconfig-paths/register ./node_modules/typeorm/cli.js schema:drop -d src/data-source.ts",
    "db:seed": "ts-node -r tsconfig-paths/register src/database/run-seed.ts",
    "db:reset": "ts-node -r tsconfig-paths/register src/database/reset-db.ts",
    "docker:dev": "docker-compose --env-file .env --env-file .env.development -f docker-compose.base.yml -f docker-compose.dev.yml up -d --build",
    "docker:dev:build": "docker-compose --env-file .env --env-file .env.development -f docker-compose.base.yml  -f docker-compose.dev.yml build",
    "docker:dev:down": "docker-compose --env-file .env --env-file .env.development -f docker-compose.base.yml  -f docker-compose.dev.yml down",
    "docker:dev:logs": "docker-compose --env-file .env --env-file .env.development -f docker-compose.base.yml  -f docker-compose.dev.yml logs -f",
    "docker:prod": "docker-compose --env-file .env --env-file .env.production -f docker-compose.base.yml  -f docker-compose.prod.yml up -d --build",
    "docker:prod:build": "docker-compose --env-file .env --env-file .env.production -f docker-compose.base.yml  -f docker-compose.prod.yml build",
    "docker:prod:down": "docker-compose --env-file .env --env-file .env.production -f docker-compose.base.yml  -f docker-compose.prod.yml down",
    "docker:prod:logs": "docker-compose --env-file .env --env-file .env.production -f docker-compose.base.yml  -f docker-compose.prod.yml logs -f",
    "docker:prod:migrate:auto": "docker-compose --env-file .env --env-file .env.production -f docker-compose.base.yml -f docker-compose.migrations.yml run --rm -e RUN_MIGRATIONS=true -e RUN_SEED=true migration-runner",
    "docker:prod:migrate:manual": "docker-compose --env-file .env --env-file .env.production -f docker-compose.base.yml -f docker-compose.migrations.yml run --rm migration-runner npm run db:migrate",
    "docker:prod:seed:manual": "docker-compose --env-file .env --env-file .env.production -f docker-compose.base.yml -f docker-compose.migrations.yml run --rm migration-runner npm run db:seed",
    "docker:prod:migrate:revert": "docker-compose --env-file .env --env-file .env.production -f docker-compose.base.yml -f docker-compose.migrations.yml run --rm migration-runner npm run db:migrate:revert",
    "docker:test": "docker-compose --env-file .env --env-file .env.test -f docker-compose.base.yml -f docker-compose.prod.yml up -d --build",
    "docker:test:down": "docker-compose --env-file .env --env-file .env.test -f docker-compose.base.yml -f docker-compose.prod.yml down",
    "docker:test:logs": "docker-compose --env-file .env --env-file .env.test -f docker-compose.base.yml -f docker-compose.prod.yml logs -f",
    "docker:test:migrate:auto": "docker-compose --env-file .env --env-file .env.test -f docker-compose.base.yml -f docker-compose.migrations.yml run --rm -e RUN_MIGRATIONS=true -e RUN_SEED=true migration-runner",
    "test:api-gateway": "dotenv -o -e .env -e .env.test -- playwright test --config=test/api-gateway/playwright.config.ts --max-failures=1",
    "test:api-gateway:ui": "dotenv -o -e .env -e .env.test -- playwright test --config=test/api-gateway/playwright.config.ts --ui",
    "test:api-gateway:report": "dotenv -o -e .env -e .env.test -- playwright show-report test/api-gateway/playwright-report"
  },
  "dependencies": {
    "@golevelup/nestjs-rabbitmq": "9.0.0",
    "@nestjs/axios": "4.0.1",
    "@nestjs/common": "11.1.17",
    "@nestjs/config": "4.0.4",
    "@nestjs/core": "11.1.17",
    "@nestjs/cqrs": "11.0.3",
    "@nestjs/jwt": "11.0.2",
    "@nestjs/passport": "11.0.5",
    "@nestjs/platform-express": "11.1.17",
    "@nestjs/swagger": "11.2.6",
    "@nestjs/throttler": "6.5.0",
    "@nestjs/typeorm": "11.0.0",
    "amqp-connection-manager": "5.0.0",
    "amqplib": "1.0.3",
    "axios": "1.15.0",
    "bcrypt": "6.0.0",
    "class-transformer": "0.5.1",
    "class-validator": "0.14.1",
    "cookie-parser": "1.4.7",
    "date-fns": "4.1.0",
    "dotenv": "17.4.1",
    "handlebars": "4.7.9",
    "nodemailer": "8.0.5",
    "passport": "0.7.0",
    "passport-jwt": "4.0.1",
    "pg": "8.20.0",
    "reflect-metadata": "0.2.2",
    "rxjs": "7.8.1",
    "typeorm": "0.3.28"
  },
  "devDependencies": {
    "@eslint/eslintrc": "3.3.5",
    "@eslint/js": "9.39.4",
    "@nestjs/cli": "11.0.16",
    "@nestjs/schematics": "11.0.9",
    "@nestjs/testing": "11.1.17",
    "@playwright/test": "1.59.1",
    "@types/amqplib": "0.10.8",
    "@types/bcrypt": "6.0.0",
    "@types/cookie-parser": "1.4.10",
    "@types/express": "5.0.6",
    "@types/handlebars": "4.0.40",
    "@types/jest": "30.0.0",
    "@types/node": "22.19.15",
    "@types/nodemailer": "8.0.0",
    "@types/passport-jwt": "4.0.1",
    "@types/pg": "8.20.0",
    "@types/supertest": "6.0.3",
    "concurrently": "9.2.1",
    "copy-webpack-plugin": "14.0.0",
    "cross-env": "10.1.0",
    "dotenv-cli": "11.0.0",
    "eslint": "9.39.4",
    "eslint-config-prettier": "10.1.8",
    "eslint-plugin-prettier": "5.5.5",
    "globals": "16.5.0",
    "jest": "30.3.0",
    "prettier": "3.8.1",
    "source-map-support": "0.5.21",
    "supertest": "7.2.2",
    "ts-jest": "29.4.6",
    "ts-loader": "9.5.4",
    "ts-node": "10.9.2",
    "tsconfig-paths": "4.2.0",
    "typescript": "5.9.3",
    "typescript-eslint": "8.57.0",
    "wait-on": "9.0.5"
  },
  "jest": {
    "moduleFileExtensions": [
      "js",
      "json",
      "ts"
    ],
    "rootDir": ".",
    "testRegex": ".*\\.spec\\.ts$",
    "transform": {
      "^.+\\.(t|j)s$": "ts-jest"
    },
    "collectCoverageFrom": [
      "apps/**/*.ts",
      "libs/**/*.ts"
    ],
    "coverageDirectory": "./coverage",
    "testEnvironment": "node",
    "roots": [
      "<rootDir>/apps/",
      "<rootDir>/libs/"
    ],
    "moduleNameMapper": {
      "@app/contracts/(.*)": "<rootDir>/libs/contracts/src/$1",
      "@app/contracts": "<rootDir>/libs/contracts/src",
      "@app/shared/(.*)": "<rootDir>/libs/shared/src/$1",
      "@app/shared": "<rootDir>/libs/shared/src"
    }
  }
}
