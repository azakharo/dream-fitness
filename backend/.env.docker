# .env.docker - Docker-specific environment configuration
# Used when running services inside Docker containers

# Database - use Docker service name instead of localhost
DATABASE_HOST=postgres

# RabbitMQ - use Docker service name instead of localhost
RABBITMQ_URL=amqp://dreamfitness:dreamfitness123@rabbitmq:5672

# Service URLs - use Docker service names for inter-service communication
AUTH_SERVICE_URL=http://auth-service:3001
TRAINING_SERVICE_URL=http://training-service:3002
BOOKING_SERVICE_URL=http://booking-service:3003
NOTIFICATION_SERVICE_URL=http://notification-service:3004
