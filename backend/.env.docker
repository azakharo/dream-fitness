# .env.docker - Docker-specific environment configuration
# Used when running services inside Docker containers

# Database - use Docker service name instead of localhost
DATABASE_HOST=postgres

# RabbitMQ - use Docker service name instead of localhost
RABBITMQ_URL=amqp://dreamfitness:dreamfitness123@rabbitmq:5672

# Service URLs - use Docker service names instead of localhost
# Services must communicate via container names in Docker network
AUTH_SERVICE_URL=http://dreamfitness-auth-service:3001
TRAINING_SERVICE_URL=http://dreamfitness-training-service:3002
BOOKING_SERVICE_URL=http://dreamfitness-booking-service:3003
NOTIFICATION_SERVICE_URL=http://dreamfitness-notification-service:3004
